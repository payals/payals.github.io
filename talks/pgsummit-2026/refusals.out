CREATE TABLE answers (
id          bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
confidence  numeric NOT NULL CHECK (confidence BETWEEN 0 AND 1),
body        jsonb   NOT NULL,
CONSTRAINT cites_something CHECK (jsonb_array_length(body->'citations') > 0)
);
